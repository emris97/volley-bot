# Explicitly permissive local Compose values. Never use this file in production.
NODE_ENV=development
POSTGRES_DB=volley
POSTGRES_USER=volley
POSTGRES_PASSWORD=volley-local
REDIS_PASSWORD=redis-local
DATABASE_URL=postgresql://volley:volley-local@postgres:5432/volley
REDIS_URL=redis://:redis-local@redis:6379
BOT_TOKEN=123456:replace_with_a_real_bot_token
TELEGRAM_WEBHOOK_SECRET=replace_with_a_random_secret
PUBLIC_BASE_URL=https://localhost:3000
LOG_LEVEL=info
API_PORT=3000
WORKER_PORT=3001
POSTGRES_PORT=5432
REDIS_PORT=6379
